index 0000000..09abb30
--- /dev/null
+++ b/pi-extension/subagents/model-preflight.ts
@@ -0,0 +1,42 @@
+import type { ExtensionContext } from "@mariozechner/pi-coding-agent";
+
+type ModelContext = Pick<ExtensionContext, "model" | "modelRegistry">;
+const modelName = (model: { provider: string; id: string }) => `${model.provider}/${model.id}`;
+
+export function modelOptions(ctx: ModelContext): string {
+  const models = ctx.modelRegistry.getAvailable();
+  const examples = new Map<string, string>();
+  if (ctx.model && models.some(m => modelName(m) === modelName(ctx.model!))) {
+    examples.set(ctx.model.provider, modelName(ctx.model));
+  }
+  for (const model of models) {
+    if (!examples.has(model.provider)) examples.set(model.provider, modelName(model));
+  }
+  return `Models with configured credentials in the parent runtime: ${[...examples.values()].slice(0, 12).join(", ") || "none"}. ` +
+    "These are credential-presence checks, not token or connectivity validation. Child credentials and provider extensions must also be available in its sandbox.";
+}
+
+export async function preflightModel(ctx: ModelContext, requested?: string | null): Promise<string> {
+  const name = requested ?? (ctx.model ? modelName(ctx.model) : "");
+  const models = ctx.modelRegistry.getAll();
+  const exact = models.find(model => modelName(model) === name);
+  const matches = exact ? [exact] : name.includes("/") ? [] : models.filter(model => model.id === name);
+  const model = matches.length === 1 ? matches[0] : undefined;
+  let reason = model ? "" : "unknown or ambiguous model; use an exact provider/model ID";
+  if (model) {
+    try {
+      // Provider-owned resolution supports stored keys, env, OAuth refresh and custom auth.
+      // Do not inspect, persist, or print the returned credentials or raw resolver errors.
+      if (!await ctx.modelRegistry.getProviderAuth(model.provider)) reason = "missing provider credentials";
+    } catch {
+      reason = "credential resolution failed; check login or credential configuration and retry";
+    }
+  }
+  if (reason) throw new Error(`Cannot launch subagent with ${JSON.stringify(name || "<no model>")}: ${reason}. Use /login for the requested provider or explicitly choose another model. ${modelOptions(ctx)}`);
+  return modelName(model!);
+}
+
+export function permanentProviderFailure(message: unknown): boolean {
+  if (typeof message !== "string") return false;
+  return /(?:\b(?:401|403)\b|\bunauthorized\b|\bforbidden\b|invalid[_ ]api[_ ]key|incorrect api key|authentication[_ ]error|no api key found|missing (?:api key|credentials)|provider is not configured|unknown provider|model .*not found|no model found|authHeader requires)/i.test(message);
+}
