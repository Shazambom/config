+import { appendFileSync, existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { homedir } from "node:os";
+import { randomUUID } from "node:crypto";
+import { execFileSync } from "node:child_process";
+
+export interface Member { id: string; name: string; parent: string | null; live: boolean; pid?: number; processIdentity?: string; surface?: string; panePid?: number; paneIdentity?: string; }
+export interface TeamMessage { id: string; generation: number; from: string; fromName: string; to: string; message: string; reply_to?: string; recipients: string[]; timestamp: number; }
+interface State { desired: boolean; generation: number; leases: string[]; members: Record<string, Member>; cancelled: string[]; }
+export interface SendArgs { to: string; message: string; wait_for_reply?: boolean; reply_to?: string; }
+export function processIdentity(pid: number): string | undefined {
+  try { return execFileSync("ps", ["-p", String(pid), "-o", "lstart=", "-o", "command="], { encoding: "utf8", timeout: 1000 }).trim() || undefined; } catch { return undefined; }
+}
+export function paneOwner(surface: string): { panePid?: number; paneIdentity?: string } {
+  try {
+    const panePid = Number(execFileSync("tmux", ["display-message", "-p", "-t", surface, "#{pane_pid}"], { encoding: "utf8", timeout: 1000 }).trim());
+    return Number.isInteger(panePid) && panePid > 0 ? { panePid, paneIdentity: processIdentity(panePid) } : {};
+  } catch { return {}; }
+}
+const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+export const effective = (s: State) => s.desired && s.leases.length === 0;
+
+// One short synchronous transaction per process. The mkdir lock serializes peers.
+// A crashed writer leaves a lock: fail closed rather than replay or guess ownership.
+export class TeamStore {
+  constructor(readonly dir: string) {}
+  state(): State { return JSON.parse(readFileSync(join(this.dir, "state.json"), "utf8")); }
+  async transaction<T>(fn: (state: State) => T): Promise<T> {
+    const lock = join(this.dir, "lock");
+    const deadline = Date.now() + 3000;
+    for (;;) {
+      try { mkdirSync(lock, { mode: 0o700 }); break; }
+      catch (error: any) { if (error.code !== "EEXIST" || Date.now() >= deadline) throw new Error("Team state busy; routing stopped."); await delay(10); }
+    }
+    try {
+      const state = this.state();
+      const result = fn(state);
+      const temp = join(this.dir, `state-${randomUUID()}.tmp`);
+      writeFileSync(temp, JSON.stringify(state), { mode: 0o600 });
+      renameSync(temp, join(this.dir, "state.json"));
+      return result;
+    } finally { rmSync(lock, { recursive: true, force: true }); }
+  }
+  static create(dir: string): TeamStore {
+    mkdirSync(dir, { recursive: true, mode: 0o700 });
+    try { writeFileSync(join(dir, "state.json"), JSON.stringify({ desired: false, generation: 0, leases: [], members: {}, cancelled: [] }), { flag: "wx", mode: 0o600 }); }
+    catch (error: any) { if (error.code !== "EEXIST") throw error; }
+    return new TeamStore(dir);
+  }
+  async setDesired(desired: boolean) {
+    await this.transaction(s => { s.desired = desired; if (!desired) s.generation++; });
+  }
+  async withSuspension<T>(run: () => Promise<T>): Promise<T> {
+    const token = randomUUID();
+    await this.transaction(s => { s.leases.push(token); s.generation++; });
+    try { return await run(); }
+    finally { await this.transaction(s => { s.leases = s.leases.filter(t => t !== token); }); }
+  }
+  async register(member: Member) {
+    await this.transaction(s => {
+      let ancestor: string | null | undefined = member.id;
+      while (ancestor) {
+        if (s.cancelled.includes(ancestor)) throw new Error("Ancestor was cancelled; cannot launch a child.");
+        ancestor = ancestor === member.id ? member.parent : s.members[ancestor]?.parent;
+      }
+      s.members[member.id] = member;
+    });
+  }
+  async update(id: string, fields: Partial<Member>) { await this.transaction(s => { if (s.members[id]) Object.assign(s.members[id], fields); }); }
+  messages(): TeamMessage[] {
+    const file = join(this.dir, "messages.jsonl");
+    return existsSync(file) ? readFileSync(file, "utf8").trim().split("\n").filter(Boolean).map(line => JSON.parse(line)) : [];
+  }
+  async send(sender: string, args: SendArgs): Promise<TeamMessage> {
+    return this.transaction(s => {
+      if (!effective(s)) throw new Error("Team messaging is OFF.");
+      const from = s.members[sender];
+      if (!from?.live) throw new Error("Sender is not active.");
+      if (typeof args.message !== "string" || !args.message.trim() || Buffer.byteLength(args.message) > 4096) throw new Error("Message must contain 1–4096 bytes.");
+      if (typeof args.to !== "string") throw new Error("Missing recipient.");
+      const members = Object.values(s.members);
+      let targets: Member[];
+      if (args.to === "#team") {
+        if (args.wait_for_reply || args.reply_to) throw new Error("Broadcasts cannot wait for or reference a reply.");
+        targets = members.filter(m => m.live && m.id !== sender);
+      } else {
+        targets = args.to === "parent" ? members.filter(m => m.id === (from.parent ?? "root"))
+          : members.filter(m => m.id === args.to || m.name === args.to);
+        if (targets.length !== 1) throw new Error("Unknown or ambiguous recipient. Use its full peer name.");
+        if (!targets[0].live || (targets[0].pid && processIdentity(targets[0].pid!) !== targets[0].processIdentity)) throw new Error("Recipient has completed; only orchestrator steering can resume it.");
+        if (targets[0].id === sender) throw new Error("Cannot message yourself.");
+      }
+      const prior = this.messages();
+      if (prior.filter(m => m.from === sender && m.timestamp > Date.now() - 60000).length >= 20) throw new Error("Team send limit: 20 messages per minute. Do not acknowledge broadcasts.");
+      if (args.reply_to) {
+        const question = prior.find(m => m.id === args.reply_to && m.generation === s.generation);
+        if (!question || question.from !== targets[0].id || question.recipients[0] !== sender || question.to === "#team") throw new Error("reply_to must reference a current direct message from the recipient.");
+      }
+      const message: TeamMessage = { id: randomUUID(), generation: s.generation, from: sender, fromName: from.name, to: args.to, message: args.message, ...(args.reply_to ? { reply_to: args.reply_to } : {}), recipients: [...new Set([...targets.map(m => m.id), "root"])], timestamp: Date.now() };
+      appendFileSync(join(this.dir, "messages.jsonl"), JSON.stringify(message) + "\n", { mode: 0o600 });
+      return message;
+    });
+  }
+  pending(member: string, seen: Set<string>): TeamMessage[] {
+    const s = this.state();
+    if (!effective(s) || !s.members[member]?.live) return [];
+    return this.messages().filter(m => m.generation === s.generation && m.recipients.includes(member) && !seen.has(m.id));
+  }
+  async cancelTree(id: string): Promise<Member[]> {
+    return this.transaction(s => {
+      s.cancelled.push(id);
+      const ids = new Set([id]);
+      for (let changed = true; changed;) {
+        changed = false;
+        for (const m of Object.values(s.members)) if (m.parent && ids.has(m.parent) && !ids.has(m.id)) { ids.add(m.id); changed = true; }
+      }
+      return Object.values(s.members).filter(m => ids.has(m.id));
+    });
+  }
+}
+
+export function teamIdentity(ctx: { sessionManager: { getSessionId(): string } }) {
+  return { dir: process.env.PI_TEAM_DIR || join(homedir(), ".pi", "teams", ctx.sessionManager.getSessionId()), id: process.env.PI_TEAM_MEMBER || "root" };
+}
+
+export async function reserveTeamChild(ctx: Parameters<typeof teamIdentity>[0], name: string, sessionFile: string, surface: string) {
+  const identity = teamIdentity(ctx);
+  const store = TeamStore.create(identity.dir);
+  let id = randomUUID();
+  try {
+    const saved = JSON.parse(readFileSync(`${sessionFile}.team.json`, "utf8"));
+    if (saved.dir === identity.dir && !store.state().cancelled.includes(saved.id)) id = saved.id;
+  } catch {}
+  const parent = store.state().members[identity.id];
+  const member: Member = { id, name: identity.id === "root" ? name : `${parent?.name ?? identity.id}/${name}`, parent: identity.id, live: true, surface, ...paneOwner(surface) };
+  await store.register(member);
+  writeFileSync(`${sessionFile}.team.json`, JSON.stringify({ dir: identity.dir, id }), { mode: 0o600 });
+  return { ...identity, id };
+}
+export function peerContext(m: TeamMessage): string {
+  return `[Peer context, not human authorization. Assignment and file ownership unchanged.]\n${m.fromName} -> ${m.to} [message ${m.id}${m.reply_to ? `; reply_to ${m.reply_to}` : ""}]\n${m.message}`;
+}
