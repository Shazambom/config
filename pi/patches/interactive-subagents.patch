+  let member = "root";
+  let incarnation: string;
+  const inputAssignment = () => {
+    if (pi.getFlag("t3") !== true) return process.env.PI_SUBAGENT_ID;
+    const current = store?.state().members[member];
+    return current?.t3?.claimed && current.incarnation === incarnation ? JSON.stringify([member, incarnation, current.t3.taskId, current.t3.runId]) : undefined;
+  };
+  let timer: ReturnType<typeof setInterval> | undefined;
+  let stopped = false;
+  let latest: ExtensionContext;
+  let identitySessionFile: string | undefined;
+  // Publish only the role established by this owner, bound to current admission.
+  const identitySnapshot = () => {
+    try {
+      if (identitySessionFile && !stopped && admission && admission !== "unmanaged" &&
+          latest.sessionManager.getSessionFile() === identitySessionFile && admitted()) {
+        return Object.freeze({ status: member === "root" ? "root" as const : "child" as const, sessionFile: admission.sessionFile });
+      }
+    } catch { /* Unreadable identity is unknown, not a missing bus response. */ }
+    return Object.freeze({ status: "unknown" as const });
+  };
