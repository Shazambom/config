+function deliverInputReceipts(running: RunningSubagent): void {
+  if (!latestPi || !running.pendingMessages || ![...running.pendingMessages.values()].includes(false)) return;
+  let entries: ReturnType<typeof getNewEntries>;
+  try { entries = getNewEntries(running.sessionFile, running.receiptLine ?? 0); }
+  catch { return; } // A partial JSONL tail is retried without advancing the cursor.
+  for (const entry of entries) {
+    const receipt = entry as any;
+    if (receipt.type !== "custom" || receipt.customType !== "subagent-message-received") continue;
+    const { messageId, assignmentId } = receipt.data ?? {};
+    if (assignmentId !== running.id || running.pendingMessages.get(messageId) !== false) continue;
+    try {
+      latestPi.sendMessage({ customType: "subagent-message-received", content: running.name + " received message " + messageId + ".", display: true, details: { messageId, assignmentId } }, { triggerTurn: true, deliverAs: "steer" });
+    } catch (error) {
+      console.error("Subagent input receipt notification failed; retaining it for the next scan.", error);
+      return;
+    }
+    running.pendingMessages.set(messageId, true);
+  }
+  running.receiptLine = (running.receiptLine ?? 0) + entries.length;
+}
