new file mode 100644
index 0000000..d631f95
--- /dev/null
+++ b/pi-extension/subagents/worker-lifecycle.ts
@@ -0,0 +1,40 @@
+import type { ExtensionAPI } from "@mariozechner/pi-coding-agent";
+import { execFileSync } from "node:child_process";
+import { existsSync } from "node:fs";
+import { join } from "node:path";
+
+export interface WorkerLaunch { owner?: string; extension?: string; assertCurrent(): void; }
+type Receipt = { sessionFile: string; generation: string };
+
+export function workerLaunches(pi: ExtensionAPI, agentDir: string): () => WorkerLaunch {
+  let managed = process.env.PI_LIFECYCLE_OWNER !== undefined;
+  const query = (): Receipt | undefined => {
+    const replies: any[] = [];
+    pi.events.emit("session-lifecycle:admission", { respond: (value: unknown) => replies.push(value) });
+    if (replies.length) managed = true;
+    if (!managed) return undefined; // Explicit legacy path: no guard, no ownership metadata.
+    const reply = replies[0];
+    if (replies.length !== 1 || reply?.managed !== true || reply.status !== "owned" ||
+        typeof reply.sessionFile !== "string" || !reply.sessionFile || typeof reply.generation !== "string" || !reply.generation) {
+      throw new Error("Worker admission unavailable; cannot launch shared workers.");
+    }
+    return { sessionFile: reply.sessionFile, generation: reply.generation };
+  };
+  return () => {
+    const receipt = query();
+    if (!receipt) return { assertCurrent() { if (query()) throw new Error("Worker admission changed during launch."); } };
+    const extension = join(agentDir, "lifecycle", "session-lifecycle.ts");
+    if (!existsSync(extension)) throw new Error("Worker lifecycle extension is missing. Run setup first.");
+    // Nested workers retain the original root bytes, never their own lock receipt.
+    let owner = process.env.PI_LIFECYCLE_OWNER;
+    if (owner === undefined) {
+      const started = execFileSync("ps", ["-p", String(process.pid), "-o", "lstart="], { encoding: "utf8", timeout: 1000 }).trim();
+      if (!started) throw new Error("Root process identity unavailable.");
+      owner = JSON.stringify({ pid: process.pid, started, sessionFile: receipt.sessionFile, generation: receipt.generation });
+    }
+    return { owner, extension, assertCurrent() {
+      const current = query();
+      if (!current || current.sessionFile !== receipt.sessionFile || current.generation !== receipt.generation) throw new Error("Worker admission changed during launch.");
+    } };
+  };
+}
