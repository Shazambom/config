+  // whereas executeTool may retain an MCP envelope. Decoding is idempotent for
+  // task projections; callers still validate exact ownership/run/terminal state.
+  if (text(result?.taskId) && text(result?.status)) return result;
+  if (result?.structuredContent) return result.structuredContent;
