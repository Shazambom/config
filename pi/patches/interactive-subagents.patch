+  let retiring = false;
+  let lifecycle = 0;
+  const invalidateRetirement = () => { lifecycle++; deferredExit = false; };
+  let unsubscribeExit: (() => void) | undefined;
+  const seen = new Set<string>();
+  const consumed = new Set<string>();
+  const history: any[] = [];
+  const queuedIds = new Set<string>();
+  let queuedGeneration = -1;
+  const waits = new Map<string, { sent: TeamMessage; deadline: number; blocked: boolean; signal?: AbortSignal }>();
+  const matchingWait = (m: TeamMessage) => {
+    const wait = m.reply_to ? waits.get(m.reply_to) : undefined;
+    return wait && wait.sent.recipients[0] === m.from ? wait : undefined;
+  };
+  const sync = () => {
+    if (!store || stopped || !admitted()) {
+      pi.setActiveTools(pi.getActiveTools().filter(t => t !== "team_send"));
+      return;
+    }
+    const state = store.state();
+    const enabled = effective(state);
+    if (!enabled || state.generation !== queuedGeneration) { queuedIds.clear(); queuedGeneration = state.generation; }
