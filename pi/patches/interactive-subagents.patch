diff --git a/pi-extension/subagents/team-arena.ts b/pi-extension/subagents/team-arena.ts
new file mode 100644
index 0000000..b7d3325
--- /dev/null
+++ b/pi-extension/subagents/team-arena.ts
@@ -0,0 +1,114 @@
+import type { ExtensionAPI, ExtensionContext } from "@mariozechner/pi-coding-agent";
+import { readFileSync } from "node:fs";
+import { TeamStore, teamIdentity, processIdentity, paneOwner, type Member } from "./team.ts";
+import { workerLaunches } from "./worker-lifecycle.ts";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+interface Running { sessionFile: string; surface: string; }
+interface Result { summary: string; exitCode: number; }
+interface Hooks {
+  launch(task: string, ctx: ExtensionContext): Promise<Running>;
+  watch(running: Running, signal: AbortSignal): Promise<Result>;
+  close(surface: string): void;
+}
+const ownedProcess = (m: Member) => !!(m.live && m.pid && m.pid !== process.pid && m.processIdentity && processIdentity(m.pid) === m.processIdentity);
+const ownedPane = (m: Member) => {
+  // A completed coordinator can leave its original shell pane behind. Only the
+  // recorded pane owner may be closed, never a replacement in the same pane ID.
+  if (!m.surface || !m.panePid || !m.paneIdentity) return false;
+  const current = paneOwner(m.surface);
+  return current.panePid === m.panePid && current.paneIdentity === m.paneIdentity;
+};
+
+export async function cleanupTeam(store: TeamStore, member: string, close: Hooks["close"], incarnation?: string, preserveMember = false) {
+    const cancelled = await store.cancelTree(member, incarnation, preserveMember);
+    const descendants = incarnation ? cancelled.filter(m => m.id !== member) : cancelled;
+    const current = (child: Member) => {
+      const state = store.state();
+      return (!incarnation || state.members[member]?.incarnation === incarnation) && state.members[child.id]?.incarnation === child.incarnation;
+    };
+    const alive = (child: Member) => current(child) && ownedProcess(child);
+    const pane = (child: Member) => current(child) && ownedPane(child);
+    // Prevent new descendants before closing surfaces; queued starts cannot escape the lease.
+    for (const child of descendants.reverse()) {
+      if (pane(child)) { try { close(child.surface!); } catch {} }
+      if (alive(child)) { try { process.kill(child.pid!, "SIGTERM"); } catch {} }
+    }
+    const deadline = Date.now() + 3000;
+    while ((descendants.some(alive) || descendants.some(pane)) && Date.now() < deadline) await new Promise(resolve => setTimeout(resolve, 50));
+    for (const child of descendants) {
+      if (alive(child)) { try { process.kill(child.pid!, "SIGKILL"); } catch {} }
+    }
+    const killDeadline = Date.now() + 3000;
+    while ((descendants.some(alive) || descendants.some(pane)) && Date.now() < killDeadline) await new Promise(resolve => setTimeout(resolve, 50));
+    if (descendants.some(alive) || descendants.some(pane)) {
+      if (!incarnation) await store.transaction(s => { s.leases.push(`cleanup-failed:${member}`); });
+      throw new Error("Team descendants still alive; cleanup incomplete.");
+    }
+    await store.retireMembers(descendants);
+}
+
+export function installArena(pi: ExtensionAPI, hooks: Hooks) {
+  const captureWorkerLaunch = workerLaunches(pi, process.env.PI_CODING_AGENT_DIR ?? join(homedir(), ".pi", "agent"));
+  const runs = new Set<{ controller: AbortController; promise?: Promise<void> }>();
+  async function run(args: string, ctx: ExtensionContext) {
+    if (args.trim() === "cancel") {
+      for (const active of runs) active.controller.abort();
+      await Promise.all([...runs].map(r => r.promise));
+      return;
+    }
+    const skill = pi.getCommands().find(c => c.source === "skill" && (c.name === "arena" || c.name === "skill:arena"));
+    if (!skill) throw new Error("Arena skill is not installed. Run setup first.");
+    const ownership = captureWorkerLaunch();
+    const store = TeamStore.create(teamIdentity(ctx).dir, () => { ownership.assertCurrent(); return true; });
+    const active = { controller: new AbortController(), promise: undefined as Promise<void> | undefined };
+    runs.add(active);
+    let outcome = "failed";
+    let errorText: string | undefined;
+    active.promise = store.withSuspension(async () => {
+      let running: Running | undefined;
+      try {
+        running = await hooks.launch(`Read and follow the arena skill at ${skill.sourceInfo.path}. Run fresh independent candidates as the skill directs. User request:\n${args}`, ctx);
+        pi.events.emit("arena:started", { sessionFile: running.sessionFile, surface: running.surface });
+        if (active.controller.signal.aborted) throw new Error("Arena cancelled.");
+        const result = await hooks.watch(running, active.controller.signal);
+        outcome = result.exitCode ? "failed" : "finished";
+        pi.sendMessage({ customType: "arena-result", content: `${active.controller.signal.aborted ? "Arena cancelled" : result.exitCode ? "Arena failed" : "Arena finished"}.\n${result.summary}`, display: true }, { deliverAs: "nextTurn" });
+      } finally {
+        if (running) {
+          const identity = JSON.parse(readFileSync(`${running.sessionFile}.team.json`, "utf8"));
+          await cleanupTeam(store, identity.id, hooks.close);
+        }
+      }
+    }).catch(error => {
+      outcome = "failed";
+      errorText = String(error?.message ?? error);
+      ctx.ui.notify(errorText, "error");
+    }).finally(() => {
+      runs.delete(active);
+      const cancelled = active.controller.signal.aborted;
+      const state = store.state();
+      const result = { status: cancelled ? "cancelled" : outcome, cancelled, effective: state.desired && state.leases.length === 0, ...(errorText ? { error: errorText } : {}) };
+      pi.appendEntry("arena-outcome", result);
+      pi.events.emit("arena:finished", result);
+      if (ctx.mode === "tui") ctx.ui.notify(`Arena ${result.status}.`, result.status === "failed" ? "error" : "info");
+    });
+    // The TUI's idle-input loop awaits command handlers. Keep it free to accept
+    // /arena cancel while the owned asynchronous job retains its try/finally lease.
+    if (ctx.mode === "tui") { ctx.ui.notify("Arena started. Use /arena cancel to stop it.", "info"); return; }
+    await active.promise;
+  }
+  pi.registerCommand("arena", { description: "Run independent arena candidates, or cancel", handler: run });
+  pi.registerCommand("skill:arena", { description: "Run arena through its runtime coordinator", handler: run });
+  pi.on("input", async (event, ctx) => {
+    const match = event.text.match(/^\/skill:arena(?:\s+([\s\S]*))?$/);
+    if (!match) return;
+    await run(match[1] ?? "", ctx);
+    return { action: "handled" as const };
+  });
+  pi.on("session_shutdown", async () => {
+    for (const run of runs) run.controller.abort();
+    await Promise.all([...runs].map(r => r.promise));
+  });
+}
