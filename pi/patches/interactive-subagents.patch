+  let admission: Admission;
+  const admitted = (captured: Admission = admission) => {
+    const current = queryAdmission();
+    if (!captured || !current) return false;
+    if (captured === "unmanaged" || current === "unmanaged") return captured === current;
+    return captured.sessionFile === current.sessionFile && captured.generation === current.generation;
+  };
