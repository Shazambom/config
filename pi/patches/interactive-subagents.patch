+      managed = true;
+      replies++;
+      if (value?.managed === true && value.status === "owned" && typeof value.sessionFile === "string" && value.sessionFile && typeof value.generation === "string" && value.generation) {
+        receipt = { sessionFile: value.sessionFile, generation: value.generation };
+      }
+    } });
+    return replies === 1 ? receipt : !managed ? "unmanaged" : undefined;
+  };
