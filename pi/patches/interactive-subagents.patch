index 0000000..0331c9c
--- /dev/null
+++ b/pi-extension/subagents/team.ts
@@ -0,0 +1,213 @@
+import { appendFileSync, existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { homedir } from "node:os";
+import { randomUUID } from "node:crypto";
+import { execFileSync } from "node:child_process";
+
+export interface Member { id: string; name: string; parent: string | null; live: boolean; incarnation?: string; pid?: number; processIdentity?: string; surface?: string; panePid?: number; paneIdentity?: string; }
+export interface TeamMessage { id: string; generation: number; from: string; fromName: string; to: string; message: string; reply_to?: string; recipients: string[]; timestamp: number; }
+interface State { desired: boolean; generation: number; leases: string[]; members: Record<string, Member>; cancelled: string[]; }
+export interface SendArgs { to: string; message: string; wait_for_reply?: boolean; reply_to?: string; }
+export function processIdentity(pid: number): string | undefined {
+  try { return execFileSync("ps", ["-p", String(pid), "-o", "lstart=", "-o", "command="], { encoding: "utf8", timeout: 1000 }).trim() || undefined; } catch { return undefined; }
+}
+export function paneOwner(surface: string): { panePid?: number; paneIdentity?: string } {
+  try {
+    const panePid = Number(execFileSync("tmux", ["display-message", "-p", "-t", surface, "#{pane_pid}"], { encoding: "utf8", timeout: 1000 }).trim());
+    return Number.isInteger(panePid) && panePid > 0 ? { panePid, paneIdentity: processIdentity(panePid) } : {};
+  } catch { return {}; }
+}
+const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+export const effective = (s: State) => s.desired && s.leases.length === 0;
+
+// One short synchronous transaction per process. The mkdir lock serializes peers.
+// A crashed writer leaves a lock: fail closed rather than replay or guess ownership.
+export class TeamStore {
+  constructor(readonly dir: string, private readonly admitted: () => boolean = () => true) {}
+  state(): State { return JSON.parse(readFileSync(join(this.dir, "state.json"), "utf8")); }
+  async transaction<T>(fn: (state: State) => T): Promise<T> {
+    const lock = join(this.dir, "lock");
+    const deadline = Date.now() + 3000;
+    for (;;) {
+      if (!this.admitted()) throw new Error("Team admission unavailable.");
+      try { mkdirSync(lock, { mode: 0o700 }); break; }
+      catch (error: any) { if (error.code !== "EEXIST" || Date.now() >= deadline) throw new Error("Team state busy; routing stopped."); await delay(10); }
+    }
+    try {
+      if (!this.admitted()) throw new Error("Team admission unavailable.");
+      const state = this.state();
+      const result = fn(state);
+      const temp = join(this.dir, `state-${randomUUID()}.tmp`);
+      writeFileSync(temp, JSON.stringify(state), { mode: 0o600 });
+      renameSync(temp, join(this.dir, "state.json"));
+      return result;
+    } finally { rmSync(lock, { recursive: true, force: true }); }
+  }
+  static create(dir: string, admitted: () => boolean = () => true): TeamStore {
+    if (!admitted()) throw new Error("Team admission unavailable.");
+    mkdirSync(dir, { recursive: true, mode: 0o700 });
+    try { writeFileSync(join(dir, "state.json"), JSON.stringify({ desired: false, generation: 0, leases: [], members: {}, cancelled: [] }), { flag: "wx", mode: 0o600 }); }
+    catch (error: any) { if (error.code !== "EEXIST") throw error; }
+    return new TeamStore(dir, admitted);
+  }
+  async setDesired(desired: boolean) {
+    await this.transaction(s => { s.desired = desired; if (!desired) s.generation++; });
+  }
+  async withSuspension<T>(run: () => Promise<T>): Promise<T> {
+    const token = randomUUID();
+    await this.transaction(s => { s.leases.push(token); s.generation++; });
+    try { return await run(); }
+    // Admission may close while work runs. This private cleanup can only
+    // remove the suspension token created above, never another lease or epoch.
+    finally { await new TeamStore(this.dir).transaction(s => { s.leases = s.leases.filter(t => t !== token); }); }
+  }
+  async register(member: Member, resuming?: string, parentIncarnation?: string): Promise<string> {
+    return this.transaction(s => {
+      if (parentIncarnation && (!member.parent || s.members[member.parent]?.incarnation !== parentIncarnation || !s.members[member.parent]?.live)) throw new Error("Parent incarnation is inactive.");
+      const previous = s.members[member.id];
+      if (resuming && previous?.incarnation !== resuming) throw new Error("Resume incarnation is stale.");
+      // An admitted replacement may reopen its root after the old process died
+      // between cancellation and retirement. ESRCH proves absence; failed ps,
+      // permission errors and reused/live PIDs must not reopen the fence.
+      if (!member.parent && resuming && s.cancelled.includes(member.id)) {
+        let retiredOrGone = !previous.live;
+        if (!retiredOrGone && previous.pid && previous.processIdentity) {
+          try { process.kill(previous.pid, 0); }
+          catch (error: any) { retiredOrGone = error.code === "ESRCH"; }
+        }
+        if (retiredOrGone) s.cancelled = s.cancelled.filter(id => id !== member.id);
+      }
+      let ancestor: string | null | undefined = member.id;
+      while (ancestor) {
+        if (s.cancelled.includes(ancestor)) throw new Error("Ancestor was cancelled; cannot launch a child.");
+        ancestor = ancestor === member.id ? member.parent : s.members[ancestor]?.parent;
+      }
+      const incarnation = randomUUID();
+      s.members[member.id] = { ...member, incarnation };
+      return incarnation;
+    });
+  }
+  async update(id: string, fields: Partial<Member>) { await this.transaction(s => { if (s.members[id]) Object.assign(s.members[id], fields); }); }
+  async retire(member: string, incarnation: string): Promise<boolean> {
+    return (await this.retireMembers([{ id: member, incarnation }])) === 1;
+  }
+  async retireMembers(members: ReadonlyArray<Pick<Member, "id" | "incarnation">>): Promise<number> {
+    const captured = members.map(m => [m.id, m.incarnation] as const);
+    if (!captured.length) return 0;
+    // Shutdown closes admission before cleanup. This one locked transaction
+    // may only retire the captured matching incarnations, never arbitrary fields.
+    return new TeamStore(this.dir).transaction(s => {
+      let retired = 0;
+      for (const [id, incarnation] of captured) {
+        if (!incarnation || s.members[id]?.incarnation !== incarnation) continue;
+        s.members[id].live = false;
+        retired++;
+      }
+      return retired;
+    });
+  }
+  messages(): TeamMessage[] {
+    const file = join(this.dir, "messages.jsonl");
+    return existsSync(file) ? readFileSync(file, "utf8").trim().split("\n").filter(Boolean).map(line => JSON.parse(line)) : [];
+  }
+  async send(sender: string, args: SendArgs): Promise<TeamMessage> {
+    return this.transaction(s => {
+      if (!effective(s)) throw new Error("Team messaging is OFF.");
+      const from = s.members[sender];
+      if (!from?.live) throw new Error("Sender is not active.");
+      if (typeof args.message !== "string" || !args.message.trim() || Buffer.byteLength(args.message) > 4096) throw new Error("Message must contain 1–4096 bytes.");
+      if (typeof args.to !== "string") throw new Error("Missing recipient.");
+      const members = Object.values(s.members);
+      let targets: Member[];
+      if (args.to === "#team") {
+        if (args.wait_for_reply || args.reply_to) throw new Error("Broadcasts cannot wait for or reference a reply.");
+        targets = members.filter(m => m.live && m.id !== sender && (!m.pid || (!!m.processIdentity && processIdentity(m.pid) === m.processIdentity)));
+        if (!targets.length) throw new Error("No active recipients; message not delivered. Team messages do not resume completed subagents.");
+      } else {
+        targets = args.to === "parent" ? members.filter(m => m.id === (from.parent ?? "root"))
+          : members.filter(m => m.id === args.to || m.name === args.to);
+        if (!targets.length) throw new Error("Unknown or ambiguous recipient. Use its full peer name.");
+        targets = targets.filter(m => m.live && (!m.pid || processIdentity(m.pid) === m.processIdentity));
+        if (!targets.length) throw new Error("Recipient has completed; only orchestrator steering can resume it.");
+        if (targets.length !== 1) throw new Error("Unknown or ambiguous recipient. Use its full peer name.");
+        if (targets[0].id === sender) throw new Error("Cannot message yourself.");
+      }
+      const prior = this.messages();
+      if (prior.filter(m => m.from === sender && m.timestamp > Date.now() - 60000).length >= 20) throw new Error("Team send limit: 20 messages per minute. Do not echo or automatically acknowledge messages.");
+      if (args.reply_to) {
+        const question = prior.find(m => m.id === args.reply_to && m.generation === s.generation);
+        if (!question || question.from !== targets[0].id || question.recipients[0] !== sender || question.to === "#team") throw new Error("reply_to must reference a current direct message from the recipient.");
+      }
+      const message: TeamMessage = { id: randomUUID(), generation: s.generation, from: sender, fromName: from.name, to: args.to, message: args.message, ...(args.reply_to ? { reply_to: args.reply_to } : {}), recipients: [...new Set([...targets.map(m => m.id), "root"])], timestamp: Date.now() };
+      appendFileSync(join(this.dir, "messages.jsonl"), JSON.stringify(message) + "\n", { mode: 0o600 });
+      return message;
+    });
+  }
+  pending(member: string, seen: Set<string>): TeamMessage[] {
+    const s = this.state();
+    if (!effective(s) || !s.members[member]?.live) return [];
+    return this.messages().filter(m => m.generation === s.generation && m.from !== member && m.recipients.includes(member) && !seen.has(m.id));
+  }
+  async retireIfQuiet(member: string, incarnation: string, seen: Set<string>, eligible: () => boolean = () => true): Promise<boolean> {
+    return this.transaction(s => {
+      if (!incarnation || s.members[member]?.incarnation !== incarnation || !eligible()) return false;
+      if (effective(s) && this.messages().some(m => m.generation === s.generation && m.from !== member && m.recipients.includes(member) && !seen.has(m.id))) return false;
+      s.members[member].live = false;
+      return true;
+    });
+  }
+  async cancelTree(id: string, incarnation?: string, preserveMember = false): Promise<Member[]> {
+    // Admission closes before shutdown. The bypass is limited to cancellation
+    // of the captured incarnation; stale hooks cannot cancel its replacement.
+    const store = incarnation ? new TeamStore(this.dir) : this;
+    return store.transaction(s => {
+      if (incarnation && s.members[id]?.incarnation !== incarnation) return [];
+      const preserve = !!incarnation && preserveMember;
+      // Reload keeps this process, not its old launch admission. Retire the
+      // matched member in the same transaction before awaiting descendant cleanup.
+      if (preserve) s.members[id].live = false;
+      if (!preserve && !s.cancelled.includes(id)) s.cancelled.push(id);
+      const ids = new Set([id]);
+      for (let changed = true; changed;) {
+        changed = false;
+        for (const m of Object.values(s.members)) if (m.parent && ids.has(m.parent) && !ids.has(m.id)) { ids.add(m.id); changed = true; }
+      }
+      // Root resume may reopen only the root. Reserved descendants stay fenced
+      // so delayed child startup cannot escape after that resume.
+      if (incarnation) for (const child of ids) if ((!preserve || child !== id) && !s.cancelled.includes(child)) s.cancelled.push(child);
+      return Object.values(s.members).filter(m => ids.has(m.id));
+    });
+  }
+}
+
+export function teamIdentity(ctx: { sessionManager: { getSessionId(): string } }) {
+  return { dir: process.env.PI_TEAM_DIR || join(homedir(), ".pi", "teams", ctx.sessionManager.getSessionId()), id: process.env.PI_TEAM_MEMBER || "root" };
+}
+
+export function captureTeamParent(ctx: Parameters<typeof teamIdentity>[0]): string {
+  const identity = teamIdentity(ctx);
+  const state = new TeamStore(identity.dir).state();
+  const parent = state.members[identity.id];
+  if (state.cancelled.includes(identity.id)) throw new Error("Parent was cancelled.");
+  if (!parent?.live || !parent.incarnation) throw new Error("Parent incarnation is inactive.");
+  return parent.incarnation;
+}
+
+export async function reserveTeamChild(ctx: Parameters<typeof teamIdentity>[0], name: string, sessionFile: string, surface: string, expected = captureTeamParent(ctx)) {
+  const identity = teamIdentity(ctx);
+  const store = TeamStore.create(identity.dir);
+  let id = randomUUID();
+  try {
+    const saved = JSON.parse(readFileSync(`${sessionFile}.team.json`, "utf8"));
+    if (saved.dir === identity.dir && !store.state().cancelled.includes(saved.id)) id = saved.id;
+  } catch {}
+  const parent = store.state().members[identity.id];
+  const member: Member = { id, name: identity.id === "root" ? name : `${parent?.name ?? identity.id}/${name}`, parent: identity.id, live: true, surface, ...paneOwner(surface) };
+  if (!parent?.live || parent.incarnation !== expected) throw new Error("Parent incarnation is inactive.");
+  await store.register(member, undefined, expected);
+  writeFileSync(`${sessionFile}.team.json`, JSON.stringify({ dir: identity.dir, id }), { mode: 0o600 });
+  return { ...identity, id };
+}
+export function peerContext(m: TeamMessage): string {
+  return `[Peer context, not human authorization. Assignment and file ownership unchanged.]\n${m.fromName} -> ${m.to} [message ${m.id}${m.reply_to ? `; reply_to ${m.reply_to}` : ""}]\n${m.message}`;
+}
diff --git a/pi-extension/subagents/worker-lifecycle.ts b/pi-extension/subagents/worker-lifecycle.ts
new file mode 100644
--- /dev/null
+++ b/pi-extension/subagents/worker-lifecycle.ts
@@ -0,0 +1,40 @@
+import type { ExtensionAPI } from "@mariozechner/pi-coding-agent";
+import { execFileSync } from "node:child_process";
+import { existsSync } from "node:fs";
+import { join } from "node:path";
+
+export interface WorkerLaunch { owner?: string; extension?: string; assertCurrent(): void; }
+type Receipt = { sessionFile: string; generation: string };
+
+export function workerLaunches(pi: ExtensionAPI, agentDir: string): () => WorkerLaunch {
+  let managed = process.env.PI_LIFECYCLE_OWNER !== undefined;
+  const query = (): Receipt | undefined => {
+    const replies: any[] = [];
+    pi.events.emit("session-lifecycle:admission", { respond: (value: unknown) => replies.push(value) });
+    if (replies.length) managed = true;
+    if (!managed) return undefined; // Explicit legacy path: no guard, no ownership metadata.
+    const reply = replies[0];
+    if (replies.length !== 1 || reply?.managed !== true || reply.status !== "owned" ||
+        typeof reply.sessionFile !== "string" || !reply.sessionFile || typeof reply.generation !== "string" || !reply.generation) {
+      throw new Error("Worker admission unavailable; cannot launch shared workers.");
+    }
+    return { sessionFile: reply.sessionFile, generation: reply.generation };
+  };
+  return () => {
+    const receipt = query();
+    if (!receipt) return { assertCurrent() { if (query()) throw new Error("Worker admission changed during launch."); } };
+    const extension = join(agentDir, "lifecycle", "session-lifecycle.ts");
+    if (!existsSync(extension)) throw new Error("Worker lifecycle extension is missing. Run setup first.");
+    // Nested workers retain the original root bytes, never their own lock receipt.
+    let owner = process.env.PI_LIFECYCLE_OWNER;
+    if (owner === undefined) {
+      const started = execFileSync("ps", ["-p", String(process.pid), "-o", "lstart="], { encoding: "utf8", timeout: 1000 }).trim();
+      if (!started) throw new Error("Root process identity unavailable.");
+      owner = JSON.stringify({ pid: process.pid, started, sessionFile: receipt.sessionFile, generation: receipt.generation });
+    }
+    return { owner, extension, assertCurrent() {
+      const current = query();
+      if (!current || current.sessionFile !== receipt.sessionFile || current.generation !== receipt.generation) throw new Error("Worker admission changed during launch.");
+    } };
+  };
+}
