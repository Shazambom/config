{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["bash", "codemode"],
  "codemode": { "mode": "on" },
  "theme": "jetbrains-dark",
  "tuiMode": "fullscreen",
  "fullscreenCopyOnSelect": false,
  "fullscreenExitOutput": "resume-hint",
  "fullscreenWheelScrollLines": 5,
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "skills": ["~/.claude/skills"],
  "prompts": [],
  "extensions": ["./lifecycle/session-lifecycle.ts", "./task-cues/index.ts", "./wakeups/index.ts", "+builtin:mcp"],
  "compaction": {
    "enabled": true,
    "reserveTokens": 128000,
    "keepRecentTokens": 40000
  },
  "observational-memory": {
    "enabled": false,
    "compactAtContextTokens": 700000,
    "compactAtContextTokensByModel": {
      "openai-codex/gpt-6-astra": 350000
    },
    "tailTokens": 40000,
    "models": {
      "observer": { "provider": "openai-codex", "id": "gpt-6.1-sol", "thinking": "medium" },
      "consolidator": { "provider": "openai-codex", "id": "gpt-6.1-sol", "thinking": "medium" }
    }
  },
  "piVimMode": {
    "keymap": { "commands": { "redo": ["alt+r"] } }
  },
  "packages": [
    "git:github.com/Shazambom/shazam-pi-goals@6e37d489941d7b04a384f4300b9891081bb16f5d",
    { "source": "../upstream/pi-vimmode", "skills": [], "prompts": [], "themes": [] },
    { "source": "../upstream/pi-interactive-subagents", "skills": [], "prompts": [], "themes": [] },
    { "source": "../upstream/pi-observational-memory", "skills": [], "prompts": [], "themes": [] },
    "../node_modules/pi-diff-review",
    { "source": "../overrides/quotas.ts", "skills": [], "prompts": [], "themes": [] }
  ]
}
