{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "theme": "jetbrains-dark",
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "skills": ["~/.claude/skills"],
  "prompts": [],
  "compaction": {
    "enabled": true,
    "reserveTokens": 128000,
    "keepRecentTokens": 40000
  },
  "observational-memory": {
    "enabled": true,
    "compactAtContextTokens": 700000,
    "compactAtContextTokensByModel": {
      "openai-codex/gpt-6-astra": 350000
    },
    "tailTokens": 40000
  },
  "packages": [
    { "source": "../upstream/pi-interactive-subagents", "skills": [], "prompts": [], "themes": [] },
    { "source": "../upstream/pi-observational-memory", "skills": [], "prompts": [], "themes": [] },
    "../node_modules/pi-diff-review",
    { "source": "../overrides/grafana-mcp.ts", "skills": [], "prompts": [], "themes": [] }
  ]
}
